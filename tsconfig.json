{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/shared/**/*.ts", "src/server/**/*.ts", "src/mcp/**/*.ts", "src/cli/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/client"]
}
